{
  "name": "meccha-chameleon",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "routes": [{ "pattern": "chameleon.omm.run", "custom_domain": true }],
  // The client built for the browser (tools/build_web.py). A path that is not
  // one of its files falls through to the worker, as before.
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" }
    ]
  },
  // Free plan requires SQLite-backed Durable Objects.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    // The live script is already at v2 and has RegistryDO (the lobby's room list) from it.
    { "tag": "v2", "new_sqlite_classes": ["RegistryDO"] }
  ]
}
